# A self-contained reverse proxy for the platform, built from files in this repository.
#
# `docker build` ships the build context as a tar stream, so this works even when the daemon
# cannot see the workspace (the reason the platform's own nginx container fails here).
FROM nginx:latest

RUN printf 'map $http_upgrade $connection_upgrade {\n    default upgrade;\n    ""      close;\n}\n' \
    > /etc/nginx/conf.d/00-upgrade-map.conf

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# The application definition, served at /dsl/app.dsl.yml so it can be downloaded from the same
# browser tab the platform UI runs in (build context is the repository's `agent/` directory).
COPY app.dsl.yml /usr/share/nginx/dsl/app.dsl.yml

# The voice module's browser client, served at /voice/
COPY deploy/voice-client.html /usr/share/nginx/voice/voice-client.html
