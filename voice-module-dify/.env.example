# ============================================================================
# voice-module (phase 3) -- the voice module calls an EXTERNAL brain.
# Copy to .env and fill in. Only the brain needs a key; speech stays local.
# ============================================================================

# ---------- 平台：负责思考的外部智能体系统 ----------
# The brain is defined by an application definition file (agent/app.dsl.yml).
# After importing it into the platform you get an app API key; paste it here.
# Self-hosted example: http://localhost/v1    Cloud example: https://api.dify.ai/v1
BRAIN_BASE_URL=http://localhost/v1
BRAIN_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# Where the platform itself lives (used only by the import script, not by the pipeline).
# Self-hosted console API is at http://localhost/console/api
BRAIN_CONSOLE_URL=http://localhost/console/api
# 0 = blocking, 1 = streaming (SSE). Streaming is the only sane choice for voice:
# the module reads the first characters while the brain is still generating.
BRAIN_STREAMING=1
# Seconds to wait for the brain's first character before giving up on this turn.
BRAIN_FIRST_TOKEN_TIMEOUT=15

# ---------- 语音模块：本地的听与说（不需要 key）----------
STT_ENGINE=whisper
WHISPER_MODEL=base
STT_LANGUAGE=zh
# Your vocabulary belongs here. Measured: listing the words this system actually hears fixed
# "保修期" (a generic prompt heard "保修气势") at no measurable latency cost. Changing
# WHISPER_MODEL to `small` was instead 2.7x slower and no more accurate -- so tune this first.
STT_PROMPT=以下是普通话的句子。常见词：居中、保修期、日志、节点、耗时、语音模块。
TTS_ENGINE=piper
PIPER_VOICE_ID=zh_CN-huayan-medium
# How long a silence means "the user finished talking". 0.6 keeps a Chinese
# sentence whole (0.2 cuts it at the first comma); see reference docs.
VAD_STOP_SECS=0.6

# Filler spoken while the brain is thinking (the brain is a network round-trip,
# not a local model -- silence would feel broken). Separate several with "|" and one is
# picked at random, so it does not say the same sentence every turn. Empty disables it.
FILLER_TEXT=嗯，我看一下。|我看看啊。|稍等，我查一下。
# Measured: the platform's first word lands at 614-960ms, so 0.8s made the filler fire even
# when the answer was already on its way. 1.1s covers the slow cases without the stutter.
FILLER_DELAY_SECS=1.1

# "Don't hand TTS a fragment": with a value set, sentences shorter than this keep accumulating,
# so each synthesis call gets more context (less choppy) -- at the cost of a later first word.
# 0 = speak on the very first sentence (default: latency first).
SPEAK_MIN_CHARS=0

# 1 = a local stand-in brain, for offline self-test only (never the real platform).
BRAIN_STUB=0
