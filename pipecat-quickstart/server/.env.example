# ============================================================================
#  pipecat-quickstart 环境变量样例
# ============================================================================
#
#  上手只要三步（唯一需要你动手的是第一行的密钥）：
#
#      1. cp .env.example .env
#      2. 把下面 MODELSCOPE_API_KEY 的值换成自己的令牌
#      3. cd server && uv run bot.py
#
#  ---------------------------------------------------------------------------
#  设计约定：以下【所有值都已按实测最优写好】，除非你明确知道自己要改什么，
#  否则一行都不用动。每个可选项都标注了「什么时候该改」和「改了会怎样」。
#
#  分三个区：
#      【必填】  只有 1 项，必须自己填
#      【常用】  可能需要按场景调整
#      【高级】  调参 / 调试用，一般永远不用碰
#
#  本文件已覆盖 bot.py 与 settings.py 读取的全部变量，
#  新增变量时请同步更新这里 —— 否则「照文档配」就会配出一个跑不起来的环境。
# ============================================================================


# ============================================================================
#  【必填】LLM 密钥（取决于下面选定的服务商，默认魔搭）
# ============================================================================

# 魔搭 ModelScope 访问令牌（LLM_PROVIDER=modelscope 时必填）
# 获取：https://modelscope.cn → 个人中心 → 访问令牌
# 说明：这是整个项目唯一花钱 / 需要注册的地方。
#       STT、TTS、VAD 全部在本地运行，不产生任何云服务调用与费用。
# 缺值时的行为：bot.py 启动即 fail-fast 报错（不会「连上了但没反应」）。
MODELSCOPE_API_KEY=


# ============================================================================
#  【常用】LLM —— 唯一的远程环节（OpenAI 兼容，可切换服务商）
# ============================================================================

# 服务商三选一：
#     modelscope（默认）  魔搭，key 用 MODELSCOPE_API_KEY
#     sensenova           商汤日日新，key 用 SENSENOVA_API_KEY
#     suanli              共绩算力 MaaS，key 用 SUANLI_API_KEY
# 都是 OpenAI 兼容接口，代码用同一个 OpenAILLMService，切换只改这一行 +
# 对应的 key / base_url / model，业务代码一行不用动。
LLM_PROVIDER=modelscope

# OpenAI 兼容端点。魔搭兼容 OpenAI 协议。
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 模型三选一（均已实测「关闭思考后」首 token < 1 秒）：
#     nex-agi/Nex-N2.5-mini             710 ms  ← 默认，最快
#     Qwen/Qwen3.8-Flash-Next           787 ms
#     deepseek-ai/DeepSeek-V4.1-Flash   817 ms
# 什么时候改：需要更强推理能力时（代价是变慢 + 可能更贵）。
# ⚠️ 这些模型需要账号余额。余额用尽会返回 429 insufficient balance，
#    表现为「机器人答不上来」。注意：旧版验证脚本会把这种失败误报成
#    「模型没有调用工具（自行作答）」—— 排查前先确认不是欠费。
#    上线前建议先跑一次阳性对照（问「现在几点了」，看能否调通）。
MODELSCOPE_MODEL=nex-agi/Nex-N2.5-mini


# ---- 商汤日日新 SenseNova（LLM_PROVIDER=sensenova 时生效）----
# 兼容 OpenAI 协议。key 形如 sk-...；关思考用 thinking={"type":"disabled"}。
# ⚠️ 注意：`enable_thinking=false` 对商汤**无效**，只有 `thinking.type=disabled` 才会
#    真正关闭思考（否则首 token 会全耗在 reasoning 上）。该写法已配在 settings 里。
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=
SENSENOVA_MODEL=sensenova-6.8-flash-lite


# ---- 共绩算力 MaaS（LLM_PROVIDER=suanli 时生效）----
# 注意：是 api.suanli.cn（大模型云服务），不是 openapi.suanli.cn（算力 Open API）。
# 兼容 OpenAI 协议，只需 key + base_url。控制台/模型广场：https://console.suanli.cn
SUANLI_BASE_URL=https://api.suanli.cn/v1
SUANLI_API_KEY=
# 共绩的 model ID 形如「厂商/模型」，以控制台/模型广场为准。
# 下面这个带 `-free` 后缀是官方示例里的免费渠道版本。
# 充值后可用 GET /v1/models 拉取本账号可用的完整列表。
SUANLI_MODEL=deepseek/deepseek-v4-flash-0731-free


# 关闭模型「思考」模式（仅 LLM_PROVIDER=modelscope 生效）。
#     Qwen / DeepSeek 默认先推理再回答，开启本项后首 token 2.5s → 0.8s（快 3 倍）。
#     1 = 关闭思考（默认，语音场景不需要长篇推理）
#     0 = 保留思考（需要复杂推理时才开）
# 这是魔搭侧最关键的一个调参。
# ⚠️ enable_thinking 是魔搭专有参数，共绩未必认；LLM_PROVIDER=suanli 时默认不注入。
LLM_DISABLE_THINKING=1

# 是否把工具（function calling）开放给 LLM。
#     1 = 开放（默认）。前端无需改动即可展示调用过程
#     0 = 关闭
# 什么时候改：只想做纯聊天、不想让模型调工具时。
ENABLE_TOOLS=1


# ============================================================================
#  【常用】语音识别 STT —— 本地运行，免费，无需 key
# ============================================================================

# 引擎二选一（asr_bench.py 实测，6 句中文测试集）：
#     sensevoice  字错率 10.2%，158ms/句  ← 默认
#                 非自回归架构，专为中文等多语种设计，又快又准
#     whisper     字错率 23.8%，607ms/句（base）
#                 通用但中文弱，且倾向输出繁体
# 结论：sensevoice 在准确率与延迟上【同时】更好，不是取舍。
# ⚠️ 用 sensevoice 需额外装依赖（CPU 版 torch 约 0.7GB + funasr），
#    详见 HANDBOOK.md 第 2 节；没装时会自动退回 whisper，不会起不来。
STT_ENGINE=sensevoice

# 显式指定识别语种。
# 不指定时 Whisper 会「自动猜语种」—— 实测既更慢（607ms）也更易错。
STT_LANGUAGE=zh

# 以下仅 STT_ENGINE=whisper 时生效。
# ⚠️ 官方默认值 Systran/faster-distil-whisper-medium.en 是【纯英文】模型，
#    中文对话会输出英文译文。中文场景必须用多语种模型：
#      base / small / medium / large-v3   （越大越准，也越慢）
#      base 23.8% / small 13.6%（字错率）
WHISPER_MODEL=base


# ============================================================================
#  【常用】语音合成 TTS —— 本地运行，免费，无需 key
# ============================================================================

# 引擎二选一（同一句中文实测「首个音频块」延迟）：
#     piper   76ms   ← 默认，音色偏机械，几乎不增加延迟
#     kokoro  709ms  —— 音色明显自然（有中文音色，如 zf_xiaoxiao），代价 +630ms
# ⚠️ 这是【真实的取舍】—— 不像 STT 那样能又快又好。
#    语音助手对「多久开口」很敏感，所以默认 piper；想要更好听就改 kokoro。
TTS_ENGINE=piper

# 中文音色。其他可选：en_US-lessac-medium（英文）
# 首次启动会自动下载到 ~/.cache/pipecat/piper/
# 什么时候改：换语种，或想换声音。
PIPER_VOICE_ID=zh_CN-huayan-medium

# 仅 TTS_ENGINE=kokoro 时生效
KOKORO_VOICE_ID=zf_xiaoxiao


# ============================================================================
#  【常用】记忆与业务数据（框架不提供，本项目自建）
# ============================================================================

# SQLite 路径。框架不带任何持久化 —— 长期记忆只给了 mem0 适配器（云端要 key），
# 知识库与数据库完全没有，所以这三块自己接。
# 三张表：turns（会话历史）/ facts（长期记忆）/ metrics（业务指标）
# 默认放在 server/data/memory.db，一般不用改。
# 之后要换 mem0 或向量库，替换点只在 server/memory.py 内，上层不用动。
# MEMORY_DB=/abs/path/to/memory.db


# ============================================================================
#  【常用】轮次判定 VAD
# ============================================================================

# 「说完」的静音阈值（秒）。VAD 不是音量阈值，是个小神经网络（Silero）。
#     0.2（官方默认）  会把一句中文按逗号处的自然停顿切成两段，LLM 只收到半句
#     0.6（默认）      整句完整，代价是多等约 0.58s
#     0.8              说话慢的人适用，但更慢
# 什么时候改：想压延迟就调小（0.6→0.45 约省 150ms，代价是长句更容易被切断）；
#             说话慢、老被打断就调大。
# 注意：这是【纯等待时间】，不消耗算力 —— 是压延迟的第一刀。
VAD_STOP_SECS=0.6


# ============================================================================
#  【常用】提示词
# ============================================================================

# 改动需谨慎：中文音色读英文会很难听，故保持中文。
# 这里强调「会被朗读，别用 emoji / markdown / 列表」——
# 否则模型输出 "#、*" 之类的符号，TTS 会念出来或跳过，体验很差。
SYSTEM_INSTRUCTION="你是一个语音助手，正在进行语音对话。你的回答会被朗读出来，所以请口语化、简短，不要使用 emoji、markdown、列表等无法朗读的格式。"

# 开场白。
# ⚠️ 历史教训：这一句曾被配置成 developer 角色，而魔搭接口不认该角色，
#    导致【每一轮都 400 静默失败】—— 浏览器界面毫无提示，看着像「连上了但没反应」。
#    必须保持 user 角色。
OPENING_MESSAGE="先用一句话简短地自我介绍。"


# ============================================================================
#  【高级】调试用 —— 一般永远不用碰
# ============================================================================

# 跳过「缺 key 即 fail-fast」的检查。
# 用途：只想调试前端 / 传输层、暂时不想配 key 时。
# ⚠️ 开启后 LLM 调用会失败，但服务能起来 —— 只用于调链路，不要留给生产。
# ALLOW_MISSING_KEY=1

# ---- 以下仅供测试脚本使用，与 bot 运行无关 ----
# 探针连接的服务端口。运行 bot.py 时若指定了 --port，跑探针要对应修改。
#   audio_probe.py / text_probe.py 读 PROBE_PORT
#   smoke.py 读 SMOKE_PORT
# ⚠️ 端口对不上会【静默拿不到结果】—— 连到没服务的端口，跑完了什么都没测到。
# PROBE_PORT=7860
# SMOKE_PORT=7860


# ============================================================================
#  配完自检
# ============================================================================
#   cd server
#   uv run ../smoke.py            # 自动拉起 bot.py 再测，测完自动关闭
#   uv run ../audio_probe.py      # 真实音频进 / 出（唯一覆盖 VAD 与 STT 的探针）
#   uv run ../asr_bench.py        # 想换 ASR 引擎时，先用它量化对比
# ============================================================================
