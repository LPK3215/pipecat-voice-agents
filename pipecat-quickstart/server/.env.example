# ============================================================
# pipecat-quickstart 环境变量
#
# 用法：
#     cp .env.example .env
#     然后把 MODELSCOPE_API_KEY 填上即可 —— 只有这一项需要你填
#
# 其余全部已按实测最优预设，可直接使用；想改再改。
# ============================================================

# ------------------------------------------------------------
# 【唯一必填】魔搭 ModelScope 访问令牌
# 获取：https://modelscope.cn → 个人中心 → 访问令牌
# ------------------------------------------------------------
MODELSCOPE_API_KEY=

# ------------------------------------------------------------
# LLM
# ------------------------------------------------------------
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 可选模型（3 选 1）。三者均已实测「关闭思考后」首 token < 1 秒：
#     nex-agi/Nex-N2.5-mini             710 ms   ← 默认，最快
#     Qwen/Qwen3.8-Flash-Next           787 ms
#     deepseek-ai/DeepSeek-V4.1-Flash   817 ms
MODELSCOPE_MODEL=nex-agi/Nex-N2.5-mini

# 关闭「思考」模式。Qwen / DeepSeek 默认先推理再回答，
# 开启本项后首 token 从约 2.5s 降到约 0.8s（快 3 倍）。
#     1 = 关闭思考（推荐，语音场景不需要长篇推理）
#     0 = 保留思考（需要复杂推理时才开）
LLM_DISABLE_THINKING=1

# ------------------------------------------------------------
# STT：本地运行，不需要任何 key
# ------------------------------------------------------------
# 引擎二选一（asr_bench.py 实测，6 句中文测试集）：
#     sensevoice  字错率 10.2%，158ms/句  ← 默认，非自回归，又快又准
#     whisper     字错率 23.8%，607ms/句（base），且倾向输出繁体
# 用 sensevoice 需额外装依赖（CPU 版 torch + funasr），见 HANDBOOK.md 第 2 节
STT_ENGINE=sensevoice

# 显式指定中文。不指定时 Whisper 会「自动猜语种」，既更慢也更易错
STT_LANGUAGE=zh

# 以下仅 STT_ENGINE=whisper 时生效
# ⚠️ 官方默认值 Systran/faster-distil-whisper-medium.en 是【纯英文】模型，
#    中文对话会输出英文译文。中文场景必须用多语种模型：
#     base / small / medium / large-v3   （越大越准，也越慢）
WHISPER_MODEL=base

# ------------------------------------------------------------
# TTS：本地运行，不需要任何 key
# ------------------------------------------------------------
# 引擎二选一（同一句中文实测「首个音频块」延迟）：
#     piper   76ms   ← 默认，音色偏机械，几乎不增加延迟
#     kokoro  709ms  —— 音色明显自然（有中文音色，如 zf_xiaoxiao），代价是 +630ms
# ⚠️ 这是真实的取舍，不像 ASR 那样能又快又好
TTS_ENGINE=piper

# 以下仅 TTS_ENGINE=piper 时生效
# 中文：zh_CN-huayan-medium      英文：en_US-lessac-medium
# 首次启动会自动下载到 ~/.cache/pipecat/piper/
PIPER_VOICE_ID=zh_CN-huayan-medium

# ------------------------------------------------------------
# 轮次判定
# ------------------------------------------------------------
# VAD「说完」的静音阈值（秒）。官方默认 0.2 会把一句中文
# 按逗号处的自然停顿切成两段，导致 LLM 只收到半句。
# 实测 0.6 可保证整句完整；说话慢的人可以调到 0.8
VAD_STOP_SECS=0.6

# ------------------------------------------------------------
# 提示词（改动需谨慎：中文音色读英文会很难听，故保持中文）
# ------------------------------------------------------------
SYSTEM_INSTRUCTION="你是一个语音助手，正在进行语音对话。你的回答会被朗读出来，所以请口语化、简短，不要使用 emoji、markdown、列表等无法朗读的格式。"
OPENING_MESSAGE="先用一句话简短地自我介绍。"
