# ============================================================
# Pipecat 最小语音 Agent - 环境变量
# 用法：cp .env.example .env  然后填入真实 key
# ============================================================

# ---------- LLM：魔搭 ModelScope（必填） ----------
# 去 https://modelscope.cn 个人中心 -> 访问令牌 获取
MODELSCOPE_API_KEY=ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 注意：base_url 与 model 名已在代码里【写死】为：
#     https://api-inference.modelscope.cn/v1
#     nex-agi/Nex-N2.5-mini
# 这里不再需要配置，改了也不会生效。
# 若要临时换模型，请直接改 bot.py / test_e2e.py / test_llm.py 里的常量。
# 选型依据见 README.md「模型已固定」一节与 logs/ANALYSIS.md。

# ---------- STT：Deepgram（必填） ----------
# https://console.deepgram.com 有免费额度
DEEPGRAM_API_KEY=

# ---------- TTS：Cartesia（必填） ----------
# https://play.cartesia.ai 有免费额度
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
