# ---- Trash / temporary directories ----
.Trash-0/
.trash/

# ---- Secrets: never commit these ----
.env
*.env
!*.env.example

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- Runtime artifacts ----
*.wav
*.onnx

# ---- Runtime logs ----
# Only *.log is ignored, so analysis reports such as logs/ANALYSIS.md stay tracked.
# 44 *.log files were once committed by mistake and had to be removed with git rm --cached.
*.log

# SQLite local persistence (generated at run time, contains conversation content, never committed)
*.db
*.db-journal
# A pattern containing an interior slash is anchored to the repository root and would not match
# pipecat-quickstart/server/data/; use **/ to match at any depth.
**/server/data/

# ---- Node / SvelteKit (pipecat-open-webui frontend) ----
node_modules/
build/
dist/
.svelte-kit/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- IDE / editors ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Operating systems ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Trash (this environment) ----
.Trash-*/

# ---- Coverage / general caches ----
.coverage
htmlcov/
.cache/
